package main

import "core:fmt"

main :: proc() {
	i: int = 7
	f := f64(i) / 2     // 3.5   — явное преобразование
	g := cast(f64)i     // 7     — то же самое
	d := 9.99
	n := int(d)         // 9     — дробная часть отбрасывается

	// h: f64 = i       // ошибка: неявных преобразований нет

	bits := transmute(u32)f32(1.0) // переинтерпретация битов
	fmt.println(f, g, n, bits)     // 3.5 7 9 1065353216
}
